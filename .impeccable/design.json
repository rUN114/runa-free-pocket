  "narrative": {
    "northStar": "月夜口袋",
    "overview": "延续已有品牌：深蓝月夜承托奶油白文字，月光金突出领取操作和当前分类。白发角色、黑猫、R 发夹及月夜像素画来自已确认的 Logo 与三张场景插画；“月夜口袋”是对现有视觉的记录名称，不是重新命名产品或重新设计品牌。\n\n商品封面、状态和操作使用 Android Views/XML，正文与控件沿用系统字体。像素风保留在图片中，文字清楚、状态具体、操作直接。原生目录、详情、账号与记录共用夜色主题；官方认证和结算进入独立的白色 WebView 区域。",
    "keyCharacteristics": [
      "深蓝底色、奶油白文字、月光金主操作。",
      "原生系统字体与控件，像素 Logo 和插画延续品牌。",
      "商品图片与可读状态并列，已拥有、未确认和失败分别表达。",
      "列表滚动，分类及领取操作保留在目录框架内。"
    ],
    "rules": [
      {
        "name": "The Status Text Rule",
        "body": "状态始终带有文字；颜色不能单独代表已拥有、同步失败或拥有状态未确认。",
        "section": "colors"
      },
      {
        "name": "The Native Units Rule",
        "body": "布局用 dp，文字用 sp；48dp 是显式设置的按钮最小宽高及复选框/返回按钮触摸尺寸，不是要求按钮固定高 48dp。内容换行时允许高度增长。",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** 保留 runa周免口袋名称、既有 Logo、三张场景插画和月夜配色。",
      "**Do** 使用 dp/sp、系统字体和可随内容增长的高度，检查大字号下的实际可见范围。",
      "**Do** 让状态文字、缓存标记与时间跟随真实数据，配合颜色帮助扫描。",
      "**Do** 根据原生列表实际宽度调整列数，保留分组和反馈的全宽布局。",
      "**Do** 为图片加载、失败重试和缺失提供不同的可读状态。"
    ],
    "donts": [
      "**Don't** 新增外部字体依赖，或用像素字体替换系统正文。",
      "**Don't** 把未知拥有状态写成未拥有，或把点击完成显示成已确认入库。",
      "**Don't** 将平台按钮外观、预览 CSS 或旧网页高度断点写成原生固定设计值。",
      "**Don't** 用品牌插画冒充商品官方封面，或将图片占位当成已加载证据。",
      "**Don't** 向官方 WebView 强行套用夜色主题，或把诊断截图当作真实交易验证。"
    ]
  }
}
